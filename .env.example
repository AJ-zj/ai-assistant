# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交
# 对话模型（SiliconFlow OpenAI 兼容接口）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V3

# 可选：联网搜索首选通道（国内，博查 Web Search API）
# 注册入口 https://open.bochaai.com/ → 控制台 API KEY 管理
BOCHA_API_KEY=

# 可选：联网搜索兼容通道（SerpAPI，海外；不填也可以联网）
SERPAPI_API_KEY=

# 可选：天气工具（心知天气）
SENIVERSE_API_KEY=

# 说明：BOCHA_API_KEY / SERPAPI_API_KEY 都不填时，联网工具自动降级为
# 免 key 的 Bing 结果页解析；配置后优先走国内博查的结构化结果。
